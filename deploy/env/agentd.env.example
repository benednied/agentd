# Copy this nonsecret template into a SHA-versioned release as release.env.
# Every bind source is deliberately exact; never replace one with /home/bened.
AGENTD_IMAGE=agentd:REPLACE_WITH_40_HEX_GIT_SHA
AGENTD_STATE_ROOT=/home/bened/.local/state/agentd
AGENTD_DB=/home/bened/.local/state/agentd/state.sqlite
AGENTD_WORKSPACE_ROOT=/home/bened/.local/share/agentd/workspaces
AGENTD_CODEX_HOME=/home/bened/.local/share/agentd/codex-home
AGENTD_UV_CACHE=/home/bened/.cache/uv
UV_CACHE_DIR=/home/bened/.cache/uv
AGENTD_REPOSITORY_ROOT=/home/bened/goldenage
AGENTD_CODEX_MODEL=gpt-5.6-terra
AGENTD_CODEX_REASONING_EFFORT=medium
AGENTD_POLL_SECONDS=1
AGENTD_ACCOUNT_POLL_SECONDS=60
AGENTD_ACCOUNT_STALE_SECONDS=300
AGENTD_QUOTA_TOP_UP_TOKENS=25000
AGENTD_HARD_CAP_GRACE_SECONDS=120
