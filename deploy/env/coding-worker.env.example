# Host provisioning inputs for the dedicated persistent coding worker.
# Keep the PSK and profiles under the exact state root with mode 0600.
AGENTD_CODING_PROFILES=/home/bened/.local/state/agentd/coding-worker/coding-profiles.json
AGENTD_CODING_WORKER_PSK=/home/bened/.local/state/agentd/coding-worker/worker.psk
AGENTD_CODING_READY=/home/bened/.local/state/agentd/coding-worker/worker.ready
AGENTD_CODING_NODE_ID=coding-worker
AGENTD_CODING_SESSION_EPOCH=production
AGENTD_WORKER_STATE_ROOT=/home/bened/.local/state/agentd/coding-worker
AGENTD_WORKER_CODEX_HOME=/home/bened/.local/share/agentd/coding-worker-codex-home
AGENTD_WORKER_BIND_PORT=38101
AGENTD_CONTROLLER_CONFIG=/home/bened/.local/state/agentd/controller.json
AGENTD_PUBLISHER_CONFIG=/home/bened/.local/state/agentd/publisher.json
