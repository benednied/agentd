[Unit]
Description=agentd trusted publisher
Documentation=file:///home/bened/.local/share/agentd/coding-current/docs/40-operations/deployment.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Restart=always
RestartSec=5s
TimeoutStartSec=infinity
TimeoutStopSec=2min
Environment=PATH=/usr/local/bin:/usr/bin:/bin
UMask=0077
ExecStart=/home/bened/.local/share/agentd/coding-current/deploy/scripts/coding-compose.sh up --no-deps coding-publisher
ExecStop=/home/bened/.local/share/agentd/coding-current/deploy/scripts/coding-compose.sh stop coding-publisher
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/bened/.local/state/agentd /home/bened/.local/share/agentd

[Install]
WantedBy=default.target
